# Audio engine (Monochrome). Defaults to the local sidecar on :5173.
# Point a phone/tablet build at a machine on your LAN, e.g. http://192.168.1.20:5173
NEXT_PUBLIC_MONOCHROME_URL=http://localhost:5173

# Recommendation backend. Defaults to the local sidecar on :8000.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Playback endpoint (optional).
# Leave blank. The audio engine resolves its own catalogue and streaming
# backends at startup, and playback works without anything set here.
# Set these only to point the engine at your own endpoint instead — the same
# thing Settings -> Streaming Endpoint does, without needing a rebuild.
NEXT_PUBLIC_PLAYBACK_API_BASE=
NEXT_PUBLIC_PLAYBACK_API_TOKEN=
