# Application
APP_NAME=AuralFlow
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secret-key-here-change-in-production

# Database. Leave empty for the local SQLite file (backend/auralflow.db).
# Any SQLAlchemy URL works here, e.g. postgresql://user:pass@host/db
DATABASE_URL=

# Where the RL agent's checkpoint lives (default: ml/models/music_rl_agent.pt)
# AURALFLOW_MODEL_PATH=

# Frontend origin, used for the local-login redirect
FRONTEND_URL=http://localhost:3000
